  "cards": [
    {
      "dot": "cyan",
      "title": "One command owns both",
      "items": [
        "switch starts the gateway and the interceptor together",
        "switch off stops both and clears the generated files"
      ]
    },
    {
      "dot": "rose",
      "title": "Refuse before writing",
      "items": [
        "Blindfold replaces the base URL override with HTTPS_PROXY",
        "A missing CA stops activation before the first file is written"
      ]
    },
    {
      "dot": "amber",
      "title": "How to recover",
      "items": [
        "Run bash blindfold/make-certs.sh chatgpt.com",
        "Then run switch codex again"
      ]
    }
  ]
