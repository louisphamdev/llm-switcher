  "transitions": [
    {
      "from": "validate",
      "to": "refused",
      "variant": "security",
      "route": "straight",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "from": "refused",
      "to": "requested",
      "variant": "dashed"
    },
    {
      "from": "starting",
      "to": "interceptor",
      "variant": "emphasis",
      "route": "straight",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "from": "active",
      "to": "stopped",
      "variant": "dashed",
      "route": "straight",
      "fromSide": "bottom",
      "toSide": "top"
