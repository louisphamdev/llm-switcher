  "cards": [
    {
      "dot": "emerald",
      "title": "Why the CLI stays quiet",
      "items": [
        "Codex keeps its official endpoint, so no base URL override exists",
        "Without that override the CLI prints no warning on its /model screen",
        "Its config.toml is never edited"
      ]
    },
    {
      "dot": "rose",
      "title": "Where each request goes",
      "items": [
        "Path under /backend-api/codex/ - the local gateway",
        "Any other path on chatgpt.com - a new TLS session to the real host",
        "Another public host - a raw byte tunnel; a local address is refused"
      ]
    },
    {
      "dot": "orange",
      "title": "The routing decision",
      "items": [
        "The path is normalized before the prefix test, never after",
        "A dot-segment escape is passed through, not routed to the gateway",
        "Only chatgpt.com is decrypted, sign-in and token refresh included"
      ]
    }
  ]
}